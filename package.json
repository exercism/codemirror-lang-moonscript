{
  "name": "@exercism/codemirror-lang-moonscript",
  "version": "1.0.0",
  "description": "MoonScript language support for CodeMirror 6",
  "author": {
    "name": "Glenn Jackman",
    "email": "glenn.jackman@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exercism/codemirror-lang-moonscript.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "tsc --noEmit"
  },
  "keywords": [
    "codemirror",
    "codemirror-6",
    "moonscript",
    "syntax-highlighting",
    "editor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.1",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.33.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
